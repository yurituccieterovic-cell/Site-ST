# Copiar para .env.local e preencher os valores
# O DATABASE_URL é substituído automaticamente pelo docker-compose.dev.yml
# Para uso direto (sem Docker): apontar para PostgreSQL local

DATABASE_URL=postgresql://pap:pap@localhost:5433/pap
SESSION_SECRET=dev-secret-change-in-prod-min32chars-xxxxxxxx
NODE_ENV=development
PORT=8080

# APIs (copiar do .pap-secrets)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_API_KEY=

# Email (ISA Bluesky e notificações)
GMAIL_ACCOUNT=
GMAIL_APP_PASSWORD=

# Bluesky ISA
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Tokens inter-agentes
MEKY_TOKEN=
ARVORE_TOKEN=
MC_TOKEN=

# Stripe (deixar vazio em dev para desabilitar pagamentos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Origens permitidas CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ARPIA (deixar vazio em dev se não estiver rodando)
ARPIA_BASE_URL=

# Vercel / GitHub (para GitHub Pages)
GITHUB_TOKEN=
